{
  "name": "podpiska",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "release": "tsx src/deploy/release.ts",
    "collect": "tsx src/collector/cli.ts",
    "issue": "tsx src/pipeline/cli.ts",
    "llm:smoke": "tsx src/llm/smoke.ts",
    "bot:setup": "tsx src/bot/setup.ts",
    "bot:dev": "tsx src/bot/dev.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@sparticuz/chromium": "153.0.0",
    "@telegram-apps/telegram-ui": "^2.1.13",
    "@tma.js/init-data-node": "^2.0.8",
    "@tma.js/sdk-react": "^3.0.23",
    "ai": "^7.0.173",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "puppeteer-core": "25.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
