# Copy to .env and fill in. Never commit .env.
# Empty values (KEY=) are treated as "not set".

# --- Database ---------------------------------------------------------------
# Postgres connection string used by the app (postgres:// or postgresql://).
# Neon: Dashboard -> Connect -> pooled connection string. Replace sslmode=require with
# sslmode=verify-full to silence the pg SSL-mode warning (same behaviour).
# Local: postgresql://postgres:postgres@localhost:5432/podpiska
DATABASE_URL=

# Optional. Direct (non-pooled) connection string, used by `pnpm db:migrate`.
# Neon's pooled endpoint is unreliable for DDL; leave empty for local Postgres.
DATABASE_URL_UNPOOLED=

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather, format: <bot id>:<secret>, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# Secret Telegram sends in the X-Telegram-Bot-Api-Secret-Token header of webhook calls.
# 1-256 chars of A-Z a-z 0-9 _ -. Generate one: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Public base URL of the app (Mini App, issue links, webhook). https only (Telegram requires it),
# no trailing slash needed. e.g. https://podpiska.vercel.app
# For local `pnpm bot:dev` use the deployed URL or an https tunnel to `pnpm dev`.
APP_URL=

# Optional. Max channels one user can subscribe to. Empty -> 50 (allowed 1..1000).
MAX_CHANNELS_PER_USER=

# --- Mini App ---------------------------------------------------------------
# Optional. Token of a second (dev) bot whose Mini App button opens this same APP_URL.
# Its initData is accepted by /api/app/*, but it never grants owner privileges.
TELEGRAM_DEV_BOT_TOKEN=

# Optional. Your numeric Telegram user id (e.g. from @userinfobot). The owner has no daily
# "build now" limit, but only when the Mini App was opened from the TELEGRAM_BOT_TOKEN bot.
OWNER_TELEGRAM_ID=

# Optional. Max issues built from the Mini App per Moscow day across all users (the owner
# included): a cap on LLM spend. Empty -> 30. Each user also has 3 builds per day.
MAX_BUILDS_PER_DAY_GLOBAL=

# Optional. Username of the public bot (without @), e.g. podpiska_news_bot. When set, every
# newspaper (web, Mini App, PDF) ends with the plate «Соберите свою газету → @<bot>».
# Empty -> no plate (recommended for a private self-host).
TELEGRAM_BOT_USERNAME=

# --- Scheduled issues -------------------------------------------------------
# Bearer secret of POST /api/cron/tick and /api/cron/run (required for automatic issues).
# At least 32 chars. Generate one: openssl rand -hex 32
# An hourly job (.github/workflows/tick.yml) calls the tick with it: set the same value as the
# CRON_SECRET repository secret, plus APP_URL. Unset -> the cron routes answer 500, never run.
CRON_SECRET=

# --- PDF --------------------------------------------------------------------
# Optional, local dev only. Path to a Chrome/Chromium binary used to render PDFs instead of
# the bundled @sparticuz/chromium (which only runs on Linux serverless, e.g. Vercel).
# e.g. /usr/bin/google-chrome. PDFs render APP_URL/issue/<id>, so APP_URL must be reachable.
CHROME_EXECUTABLE_PATH=

# --- LLM --------------------------------------------------------------------
# LLM provider. Supported: google (default).
LLM_PROVIDER=google

# Fast model for per-channel digests. Empty -> gemini-3.5-flash-lite.
LLM_MODEL_FAST=

# Smart model that composes the issue. Empty -> gemini-3.5-flash.
# gemini-4-carbon gives higher quality but costs much more per issue. Note: ProxyAPI
# reserves balance for the full maxOutputTokens up front (fast 8k, smart 12k tokens).
LLM_MODEL_SMART=

# Optional. Base URL of a Gemini-compatible proxy (no trailing slash needed).
# Empty -> Google's own API (https://generativelanguage.googleapis.com/v1beta).
# e.g. ProxyAPI (pay in RUB, works from Russia): https://api.proxyapi.ru/google/v1beta
LLM_BASE_URL=

# Google AI Studio API key (or your proxy's key), required when LLM_PROVIDER=google.
# Sent in the x-goog-api-key header. Get it at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
