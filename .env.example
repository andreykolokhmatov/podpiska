# Copy to .env and fill in. Never commit .env.
# Empty values (KEY=) are treated as "not set".
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# =============================================================================
# Required
# =============================================================================

# Postgres connection string used by the app (postgres:// or postgresql://).
# Neon: Dashboard -> Connect -> pooled connection string. Replace sslmode=require with
# sslmode=verify-full to silence the pg SSL-mode warning (same behaviour).
# Local: postgresql://postgres:postgres@localhost:5432/podpiska
DATABASE_URL=

# Bot token from @BotFather, format: <bot id>:<secret>, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# Google AI Studio API key (or your proxy's key), required when LLM_PROVIDER=google.
# Sent in the x-goog-api-key header. Get it at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Your numeric Telegram user id (e.g. from @userinfobot). Required unless PUBLIC=1: by default
# the instance is private and only the owner (plus ALLOWED_TELEGRAM_IDS) can use it.
# The owner has no daily "build now" limit, but only when the Mini App was opened from the
# TELEGRAM_BOT_TOKEN bot.
OWNER_TELEGRAM_ID=

# =============================================================================
# Derived automatically (set explicitly to override)
# =============================================================================

# Public base URL of the app (Mini App, issue links, webhook). https only (Telegram requires it),
# no trailing slash needed. e.g. https://podpiska.vercel.app
# On Vercel it defaults to https://$VERCEL_PROJECT_PRODUCTION_URL. Required everywhere else.
# For local `pnpm bot:dev` use the deployed URL or an https tunnel to `pnpm dev`.
APP_URL=

# Secret Telegram sends in the X-Telegram-Bot-Api-Secret-Token header of webhook calls.
# 1-256 chars of A-Z a-z 0-9 _ -. Empty -> HMAC-SHA256 of TELEGRAM_BOT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=

# Bearer secret of POST /api/cron/tick and /api/cron/run (automatic issues). At least 32 chars.
# Empty -> HMAC-SHA256 of TELEGRAM_BOT_TOKEN. An external hourly job calls the tick with it
# (primary: e.g. cron-job.org; backup: .github/workflows/tick.yml with the CRON_SECRET and
# APP_URL repository secrets), so set it explicitly if you need to paste it there.
CRON_SECRET=

# =============================================================================
# Optional
# =============================================================================

# --- Access ------------------------------------------------------------------
# 1 -> anyone can use the bot and the Mini App. Empty -> private: only OWNER_TELEGRAM_ID and
# ALLOWED_TELEGRAM_IDS.
PUBLIC=

# Comma-separated numeric Telegram user ids allowed in addition to the owner,
# e.g. 123456789,987654321. Ignored when PUBLIC=1.
ALLOWED_TELEGRAM_IDS=

# Telegram username (without @) shown in /privacy as the contact for data deletion requests.
PRIVACY_CONTACT=

# --- Database ----------------------------------------------------------------
# Direct (non-pooled) connection string, used for migrations (`pnpm db:migrate` and the
# release step). Neon's pooled endpoint is unreliable for DDL; leave empty for local Postgres.
DATABASE_URL_UNPOOLED=

# 1 -> the release step (`pnpm release`, run before `pnpm build` on Vercel production deploys)
# skips database migrations.
SKIP_DB_MIGRATE=

# --- Limits ------------------------------------------------------------------
# Max channels one user can subscribe to. Empty -> 50 (allowed 1..1000).
# The owner (OWNER_TELEGRAM_ID, prod bot) has no limit in the Mini App; the bot still applies it.
MAX_CHANNELS_PER_USER=

# Max issues built per Moscow day across all users, manual and scheduled (the owner
# included): a cap on LLM spend. Empty -> 30. Each user also has 3 manual builds per day.
MAX_BUILDS_PER_DAY_GLOBAL=

# t.me checks of unknown channels per user per Moscow day when adding channels as a
# list in the Mini App (cached channels are free; the owner has no limit). Empty -> 300.
MAX_CHANNEL_LOOKUPS_PER_DAY=

# --- Mini App / branding -----------------------------------------------------
# Token of a second (dev) bot whose Mini App button opens this same APP_URL.
# Its initData is accepted by /api/app/*, but it never grants owner privileges.
TELEGRAM_DEV_BOT_TOKEN=

# Username of the public bot (without @), e.g. podpiska_news_bot. When set, every
# newspaper (web, Mini App, PDF) ends with the plate «Соберите свою газету → @<bot>».
# Empty -> no plate (recommended for a private self-host).
TELEGRAM_BOT_USERNAME=

# off -> hide the «Сделано на Подписке» credit linking to the project's GitHub.
PODPISKA_CREDIT=

# --- PDF ---------------------------------------------------------------------
# Local dev only. Path to a Chrome/Chromium binary used to render PDFs instead of
# the bundled @sparticuz/chromium (which only runs on Linux serverless, e.g. Vercel).
# e.g. /usr/bin/google-chrome. PDFs render APP_URL/issue/<id>, so APP_URL must be reachable.
CHROME_EXECUTABLE_PATH=

# --- LLM ---------------------------------------------------------------------
# LLM provider. Supported: google (default).
LLM_PROVIDER=google

# Fast model for per-channel digests. Empty -> gemini-3.5-flash-lite.
LLM_MODEL_FAST=

# Smart model that composes the issue. Empty -> gemini-3.5-flash.
# gemini-4-carbon gives higher quality but costs much more per issue. Note: ProxyAPI
# reserves balance for the full maxOutputTokens up front (fast 8k, smart 12k tokens).
LLM_MODEL_SMART=

# Base URL of a Gemini-compatible proxy (no trailing slash needed).
# Empty -> Google's own API (https://generativelanguage.googleapis.com/v1beta).
# e.g. ProxyAPI (pay in RUB, works from Russia): https://api.proxyapi.ru/google/v1beta
LLM_BASE_URL=

# Parallel LLM calls while building an issue, 1..10. Empty -> 3.
# Set 1 on a free-tier key if builds fail with 429 (rate limit).
LLM_CONCURRENCY=
